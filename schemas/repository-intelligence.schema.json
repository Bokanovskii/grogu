{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grogu.dev/schemas/repository-intelligence.schema.json",
  "title": "Grogu repository intelligence and knowledge graph",
  "type": "object",
  "required": ["schema_version", "kind", "repository_id", "derivation"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"enum": ["grogu.repository_intelligence", "grogu.repository_inventory", "grogu.knowledge_graph", "grogu.repository_context"]},
    "repository_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "derivation": {"type": "string", "minLength": 1},
    "files": {"type": "object"},
    "summary": {"type": "object"},
    "nodes": {"type": "object"},
    "edges": {"type": "array"},
    "repository": {"type": "object"}
  },
  "additionalProperties": true
}
