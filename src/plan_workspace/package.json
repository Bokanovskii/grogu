{
  "name": "grogu-plan-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Figma-style browser workspace for the .plan document graph. Five modes (Control room, Document, Canvas, Dependencies, Revision) over the frozen HTTP/DTO contract.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/licenses.mjs",
    "build:vite": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "licenses": "node scripts/licenses.mjs",
    "fixture": "node tests/fixture-server.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.11.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.7.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
